# Embrix AI Agent Environment Configuration Example

# =====================================================================
# 1. PostgreSQL Production Read-Only Database Connection
# =====================================================================
DB_HOST=10.22.16.238
DB_PORT=5432
DB_NAME=coredb
DB_USER=ebrx-ro-dev
DB_PASSWORD=your_production_db_password_here

# =====================================================================
# 2. Meta Database Vector Store (pgvector / SQLite fallback)
# Note: If META_DB_HOST is localhost or unconfigured, the system automatically
# uses local SQLite (agent-app/embrix_meta.db) without needing any password.
# If using a local PostgreSQL instance with pgvector, specify your postgres user password.
# =====================================================================
META_DB_NAME=embrix_meta
META_DB_HOST=localhost
META_DB_PORT=5432
META_DB_USER=postgres
META_DB_PASSWORD=your_local_postgres_password_or_leave_blank_for_sqlite

# =====================================================================
# 3. Multi-Model Google Gemini API Key Pool & Free Tier Quota Limits
# =====================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Model 1: Gemini 3.1 Flash Lite (Primary)
GEMINI_31_FLASH_LITE_RPM=15
GEMINI_31_FLASH_LITE_TPM=250000
GEMINI_31_FLASH_LITE_RPD=500

# Model 2: Gemini 3 Flash (Secondary)
GEMINI_3_FLASH_RPM=5
GEMINI_3_FLASH_TPM=250000
GEMINI_3_FLASH_RPD=20

# Model 3: Gemini 2.5 Flash Lite (Tertiary)
GEMINI_25_FLASH_LITE_RPM=10
GEMINI_25_FLASH_LITE_TPM=250000
GEMINI_25_FLASH_LITE_RPD=20

# =====================================================================
# 4. Local Ollama Provider Settings (Fallback Provider)
# =====================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5

# =====================================================================
# 5. REST API Server Configuration
# =====================================================================
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
